# Set these in Vercel. Never prefix these values with NEXT_PUBLIC_.
SOURCE_DASHBOARD_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-random-32-byte-secret

# Public media repository. The receiver reads sources/ from this repository.
SOURCE_GITHUB_OWNER=john22175
SOURCE_GITHUB_REPOSITORY=t-sources
SOURCE_GITHUB_BRANCH=main

# Server-only fine-grained token for browsing, moving, deleting, and creating
# source folders. Limit it to the media-only source repository.
GITHUB_SOURCE_MANAGER_TOKEN=github-fine-grained-token

# GitHub App installed only on the media repository, Contents: Read and write.
# The dashboard issues this app's short-lived installation token to an already
# authenticated browser for one direct GitHub upload; never make it public.
GITHUB_SOURCE_UPLOAD_APP_ID=123456
GITHUB_SOURCE_UPLOAD_INSTALLATION_ID=12345678
GITHUB_SOURCE_UPLOAD_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Private command-manifest repository and its server-only GitHub App.
CONTROL_GITHUB_OWNER=john22175
CONTROL_GITHUB_REPOSITORY=tv-control
CONTROL_GITHUB_BRANCH=main
GITHUB_CONTROL_APP_ID=123456
GITHUB_CONTROL_INSTALLATION_ID=12345678
GITHUB_CONTROL_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
